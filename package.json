{
  "name": "@local/dsh-prompt-optimizer",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "description": "DSH 输入框的提示词优化按钮：把草稿改写成结构清晰的提示词，用当前会话模型，流式生成，一次撤销即可还原。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-engineering",
    "deepseek",
    "harness"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check lib/heuristic.js && node --check lib/templates.js && node --check lib/sse.js",
    "release": "node scripts/release.mjs"
  },
  "publishName": "@infcel/dsh-prompt-optimizer"
}
